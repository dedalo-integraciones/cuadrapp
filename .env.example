# ── Turso: base de plataforma (core) ─────────────────────────────────────────
# Local (desarrollo): file:./data/cuadra-core.db
# Turso: libsql://cuadra-core-<org>.aws-us-east-1.turso.io
TURSO_CORE_URL=file:./data/cuadra-core.db
TURSO_CORE_TOKEN=

# ── Turso: bases por negocio (tenant) ────────────────────────────────────────
# URL por defecto para scripts de migración/seed cuando el tenant aún no existe.
# Local: file:./data/cuadra-app.db
# Turso: libsql://cuadra-app-<org>.aws-us-east-1.turso.io
TURSO_APP_URL=file:./data/cuadra-app.db
# El token se usa para todas las bases de tenant (token de grupo).
# Local: dejar vacío.
TURSO_APP_TOKEN=

# ── Negocio por defecto ──────────────────────────────────────────────────────
# Identificador del tenant que atiende la tienda y el panel si no se indica otro.
TENANT_OVERRIDE=cuadra
# Slug que se compila en el frontend. Obligatorio para npm run build.
VITE_TENANT=cuadra

# ── Sesión del panel ─────────────────────────────────────────────────────────
# Firma HMAC del token de sesión. Mínimo 32 caracteres. No commitear valores reales.
SESSION_SECRET=

# ── Alta inicial (solo scripts) ──────────────────────────────────────────────
# Se usan una vez con npm run db:admin; no se exponen al cliente.
ADMIN_EMAIL=admin@cuadra.app
ADMIN_PASSWORD=CambiarEstaClave123
ADMIN_NAME=Administrador Cuadra

# ── Imágenes (opcional) ──────────────────────────────────────────────────────
# Sin estas variables el panel acepta URL de imagen, pero no sube archivos.
# CLOUDINARY_FOLDER es obligatorio cuando hay credenciales.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cuadra
